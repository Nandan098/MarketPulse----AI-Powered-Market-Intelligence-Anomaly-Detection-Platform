# Used by Docker Compose. Local Python development defaults to SQLite.
POSTGRES_DB=marketpulse
POSTGRES_USER=marketpulse
POSTGRES_PASSWORD=replace-this-development-password
DATABASE_URL=postgresql+psycopg://marketpulse:replace-this-development-password@db:5432/marketpulse
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
